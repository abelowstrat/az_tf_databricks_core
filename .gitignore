# ===========================
# Terraform
# ===========================

# Local Terraform state files
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# Crash log files
crash.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Terraform directories
.terraform/

# ===========================
# Databricks
# ===========================

# Databricks-specific secrets and configurations
# It's good practice to keep sensitive configurations out of version control
secrets/*.tfvars
secrets/*.json

# Databricks notebooks (if exporting/importing)
# Adjust the path based on your project structure
**/notebooks/*.dbc
**/notebooks/*.json

